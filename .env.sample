# BC-Bench Environment Variables
# Copy this file to .env and fill in your values

# Azure DevOps Personal Access Token (required for reading NAV PRs, Work Items and connecting to bc-eval package)
ADO_TOKEN=your_ado_token_here

# BC Container (Docker container name, consumed by BCContainerHelper)
BC_CONTAINER_NAME=bcbench

# BC server connection
BC_SERVER_URL=http://bcbench
BC_SERVER_INSTANCE=BC
BC_SERVER_USERNAME=admin
BC_SERVER_PASSWORD=your_container_password_here

# Optional: Set to "1" to enable debug logging in GitHub Actions
# RUNNER_DEBUG=1

# bcal agent (required for 'bcbench run bcal' / 'bcbench evaluate bcal')
BCAL_LLM_COMMAND=python -m bcbench.agent.bcal.bc_eval_llm_api_bridge
# BCAL_LLM_MODEL=gpt-55-chat-2026-04-29  # optional unprefixed model alias passed to the M365 LLM API

# AI red teaming ('bcbench redteam scan') -- needs `uv sync --extra redteam`, an Azure AI Foundry Hub project, plus `az login`.
# AZURE_SUBSCRIPTION_ID=<subscription-guid>
# AZURE_RESOURCE_GROUP=<resource-group>
# AZURE_PROJECT_NAME=<foundry-hub-project>

# Optional direct M365 LLM API overrides. bc-eval defaults to TEST and authenticates with managed
# identity, EnvironmentCredential, then Azure CLI. The selected identity needs Key Vault Crypto User
# access to the configured/default LLM API certificate vault.
# LLM_API_ENVIRONMENT=TEST
# LLM_API_SCENARIO_GUID=<scenario-guid>
# LLM_API_TENANT_ID=<tenant-id>
# LLM_API_CLIENT_ID=<client-id>
# LLM_API_CERTIFICATE_KEY_VAULT=<key-vault-name>
# LLM_API_CERTIFICATE_NAME=<certificate-name>
# LLM_API_SERVICE_TIER=<service-tier>
# LLM_API_PARTNER_SOURCE=<partner-source>
